# SIF Memory Dev Layer
# Builds on top of openclaw:local base image
#
# Build:
#   docker build -t openclaw-sifdev:local \
#     -f extensions/sif-memory/dev/Dockerfile.sifdev .
# (context = repo root)

FROM openclaw:local

LABEL sifdev.component="sif-memory"
ARG BUILD_DATE=""
LABEL sifdev.built-at="${BUILD_DATE}"

USER root

# Copy SIF extension into the image (overwrites any version from base build)
# Fix permissions: WSL2/Windows mounts show mode=777 which triggers the
# plugin security check ("world-writable path" rejection). Force 755/644.
COPY --chown=node:node extensions/sif-memory/ /app/extensions/sif-memory/
RUN find /app/extensions/sif-memory -type d -exec chmod 755 {} + && \
    find /app/extensions/sif-memory -type f -exec chmod 644 {} +

# Populate workspace files (agent persona, memory seed, tools reference)
COPY --chown=node:node extensions/sif-memory/dev/workspace/ /home/node/.openclaw/workspace/
RUN find /home/node/.openclaw/workspace -type f -exec chmod 644 {} +

# Pre-configure memory.backend=sif + skip device pairing for Control UI (dev only)
RUN mkdir -p /home/node/.openclaw/sif && \
    chown -R node:node /home/node/.openclaw && \
    echo '{"memory":{"backend":"sif"},"gateway":{"controlUi":{"dangerouslyDisableDeviceAuth":true}},"plugins":{"enabled":true,"allow":["sif-memory"],"slots":{"memory":"sif-memory"}}}' > /home/node/.openclaw/openclaw.json && \
    chown node:node /home/node/.openclaw/openclaw.json

# Install healthcheck script
COPY --chown=node:node extensions/sif-memory/dev/healthcheck.sh /app/healthcheck.sh
RUN chmod +x /app/healthcheck.sh

USER node

# Persist the SIF graph data across container restarts
VOLUME /home/node/.openclaw/sif

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD ["/app/healthcheck.sh"]

EXPOSE 18789

CMD ["node", "openclaw.mjs", "gateway", "--bind", "lan", "--port", "18789", "--allow-unconfigured"]
